QWidget#messageEditPanel {
    background-color: #191919;
    border-top: 1px solid #303030;
}

QPushButton#toolButton {
    border-radius: 4px;
}

QPushButton#toolButton:hover {
    background-color: #2b2b2b;
}

QPushButton#toolButton:pressed {
    background-color: #343434;
}

QPushButton#sendButton {
    color: #d8d8d8;
    background-color: #333333;
    border: none;
    border-radius: 5px;
    font-size: 13px;
    padding: 0 18px;
}

QPushButton#sendButton:hover {
    color: #f0f0f0;
    background-color: #3d3d3d;
}

QPushButton#sendButton:pressed {
    color: #ffffff;
    background-color: #245f43;
}

QPlainTextEdit#messageTextEdit {
    color: #eeeeee;
    background-color: #191919;
    border: none;
    font-size: 14px;
    selection-background-color: #3b7f5b;
    padding: 0;
}

QPlainTextEdit#messageTextEdit QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QPlainTextEdit#messageTextEdit QScrollBar::handle:vertical {
    background-color: #4a4a4a;
    border-radius: 4px;
    min-height: 24px;
}

QPlainTextEdit#messageTextEdit QScrollBar::handle:vertical:hover {
    background-color: #5a5a5a;
}

QPlainTextEdit#messageTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit#messageTextEdit QScrollBar::sub-line:vertical {
    width: 0;
    height: 0;
}

QPlainTextEdit#messageTextEdit QScrollBar::add-page:vertical,
QPlainTextEdit#messageTextEdit QScrollBar::sub-page:vertical {
    background: transparent;
}
