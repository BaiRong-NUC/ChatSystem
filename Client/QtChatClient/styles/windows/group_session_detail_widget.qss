QWidget#groupSessionDetailWidget,
QScrollArea#groupSessionDetailScrollArea,
QWidget#groupSessionDetailContent {
    background-color: #292929;
    border: none;
}

QWidget#groupSessionDetailWidget {
    border: 1px solid #3e3e3e;
}

QWidget#groupSessionMemberGrid,
QWidget#groupSessionInformationRow,
QWidget#groupSessionSettingRow {
    background-color: transparent;
    border: none;
}

QScrollBar#groupSessionDetailScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 4px 0;
    border: none;
}

QScrollBar#groupSessionDetailScrollBar::handle:vertical {
    background-color: #686868;
    min-height: 36px;
    border-radius: 4px;
    margin: 0 2px;
}

QScrollBar#groupSessionDetailScrollBar::handle:vertical:hover {
    background-color: #777777;
}

QScrollBar#groupSessionDetailScrollBar::add-line:vertical,
QScrollBar#groupSessionDetailScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar#groupSessionDetailScrollBar::add-page:vertical,
QScrollBar#groupSessionDetailScrollBar::sub-page:vertical {
    background: transparent;
}

QPushButton#groupSessionShowMoreButton {
    color: #a9a9a9;
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 14px;
}

QPushButton#groupSessionShowMoreButton:hover {
    color: #dedede;
    background-color: #313131;
}

QFrame#groupSessionDetailDivider {
    color: #3a3a3a;
    background-color: #3a3a3a;
    border: none;
    max-height: 1px;
}

QLabel#groupSessionInformationTitle {
    color: #ededed;
    background: transparent;
    font-size: 15px;
    font-weight: 500;
}

QLabel#groupSessionInformationValue {
    color: #a8a8a8;
    background: transparent;
    font-size: 14px;
}

QPushButton#groupSessionNavigationButton {
    color: #ededed;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    text-align: left;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#groupSessionNavigationButton:hover {
    color: #ffffff;
    background-color: transparent;
}

QPushButton#groupSessionNavigationButton:pressed {
    background-color: transparent;
}

QLabel#groupSessionSettingLabel {
    color: #ededed;
    background: transparent;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#groupSessionSwitch {
    background-color: transparent;
    border: none;
    padding: 0;
}

QPushButton#groupSessionClearHistoryButton,
QPushButton#groupSessionExitGroupButton {
    color: #f05d5d;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#groupSessionClearHistoryButton:hover,
QPushButton#groupSessionExitGroupButton:hover {
    color: #ff7373;
    background-color: #3a2929;
}

QPushButton#groupSessionClearHistoryButton:pressed,
QPushButton#groupSessionExitGroupButton:pressed {
    color: #d34e4e;
    background-color: #302323;
}
