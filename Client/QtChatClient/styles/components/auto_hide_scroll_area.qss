QScrollBar#autoHideScrollAreaOverlayScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 0;
    border: none;
}

QScrollBar#autoHideScrollAreaOverlayScrollBar::handle:vertical {
    background-color: #606060;
    min-height: 36px;
    border-radius: 4px;
    margin: 0 2px;
}

QScrollBar#autoHideScrollAreaOverlayScrollBar::handle:vertical:hover {
    background-color: #707070;
}

QScrollBar#autoHideScrollAreaOverlayScrollBar::add-line:vertical,
QScrollBar#autoHideScrollAreaOverlayScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar#autoHideScrollAreaOverlayScrollBar::add-page:vertical,
QScrollBar#autoHideScrollAreaOverlayScrollBar::sub-page:vertical {
    background: transparent;
}
